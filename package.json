{
	"name": "nalla-gizmos",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.31.0",
	"scripts": {
		"clean": "turbo clean",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"check-types": "turbo check-types",
		"build": "turbo build",
