		"@types/node": "^25.3.3",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"concurrently": "^10.0.4",
		"eslint": "^9.39.3",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"sass": "^1.89.2",
		"turbo": "^2.8.13",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
