{
	"name": "@nalla-gizmos/helpers-dev",
	"type": "module",
	"version": "0.1.0",
	"description": "Development utilities & tooling for Nalla Gizmos",
	"author": "Allan Joshua",
	"license": "MIT",
	"homepage": "https://github.com/theallanjoshua/nalla-gizmos/tree/main/gizmos/helpers/dev#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/theallanjoshua/nalla-gizmos.git",
		"directory": "gizmos/helpers/dev"
	},
	"bugs": {
		"url": "https://github.com/theallanjoshua/nalla-gizmos/issues"
	},
	"keywords": [
		"nalla-gizmos",
		"dev tools",
		"dev configs",
		"linters",
		"compilers",
		"vite",
		"eslint",
		"typescript",
		"react"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tsconfigs/*": "./tsconfigs/*"
	},
	"main": "dist/index.js",
	"types": "dist/lib/index.d.ts",
	"files": [
		"dist",
		"tsconfigs"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"check-types": "tsc --noEmit",
		"dev": "vite build --watch",
		"build": "vite build",
		"validate": "pnpm clean && pnpm lint && pnpm check-types && pnpm build",
		"prepublishOnly": "pnpm validate"
	},
	"peerDependencies": {
		"eslint": "^9.39.3",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@antfu/eslint-config": "^7.4.3",
		"@eslint-react/eslint-plugin": "^2.13.0",
		"@vitejs/plugin-react": "^4.6.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vite-tsconfig-paths": "^5.1.4"
	}
}
